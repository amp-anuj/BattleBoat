<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Amplitude-branded dark theme -->
    <style name="Theme.Battleboat" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/amp_blue</item>
        <item name="colorPrimaryVariant">@color/amp_navy</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/amp_teal</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/amp_navy</item>
        <item name="colorOnBackground">@color/amp_text_primary</item>
        <item name="colorSurface">@color/amp_surface</item>
        <item name="colorOnSurface">@color/amp_text_primary</item>
        <item name="android:statusBarColor">@color/amp_navy</item>
        <item name="android:navigationBarColor">@color/amp_navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Grid Cell -->
    <style name="GridCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@drawable/grid_cell_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Primary CTA Button — Amplitude Blue -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/margin_medium</item>
        <item name="android:padding">@dimen/padding_large</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/amp_blue</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Secondary Outlined Button -->
    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/margin_medium</item>
        <item name="android:padding">@dimen/padding_large</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/amp_text_secondary</item>
        <item name="strokeColor">@color/amp_border</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Title Text -->
    <style name="TitleText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/amp_text_primary</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="SubtitleText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/amp_text_secondary</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/amp_text_secondary</item>
    </style>

    <!-- Ship Dock -->
    <style name="ShipView">
        <item name="android:layout_margin">@dimen/margin_small</item>
        <item name="android:background">@drawable/ship_background</item>
        <item name="android:elevation">@dimen/elevation_small</item>
    </style>

</resources>
