<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATTLEBOAT"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/amp_text_primary"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Enemy Grid Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENEMY WATERS"
                android:textSize="11sp"
                android:textColor="@color/amp_coral"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <!-- Grid card -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/amp_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp">

                <com.battleboat.GridView
                    android:id="@+id/enemy_grid"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:padding="8dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Status / Game Message -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Place Your Ships"
            android:textSize="14sp"
            android:textColor="@color/amp_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="#1D2433"
            android:letterSpacing="0.01" />

        <!-- Action Button -->
        <Button
            android:id="@+id/action_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Auto Place Ships"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/amp_blue"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="28dp"
            app:cornerRadius="10dp" />

        <!-- Player Grid Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR FLEET"
                android:textSize="11sp"
                android:textColor="@color/amp_teal"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/amp_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp">

                <com.battleboat.GridView
                    android:id="@+id/player_grid"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:padding="8dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Instructions chip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap your grid to place ships  ·  Tap enemy grid to fire  ·  Sink all ships to win"
            android:textSize="12sp"
            android:textColor="@color/amp_text_muted"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="14dp"
            android:background="#1D2433" />

        <!-- Statistics Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/amp_surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATISTICS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/amp_text_muted"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Win Stats -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WINS"
                            android:textSize="10sp"
                            android:textColor="@color/amp_text_muted"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/stats_wins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 of 0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amp_blue_light" />

                        <TextView
                            android:id="@+id/stats_win_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textColor="@color/amp_text_muted" />

                    </LinearLayout>

                    <!-- Accuracy Stats -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACCURACY"
                            android:textSize="10sp"
                            android:textColor="@color/amp_text_muted"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/stats_accuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amp_teal" />

                        <TextView
                            android:id="@+id/stats_shots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 hits / 0 shots"
                            android:textSize="12sp"
                            android:textColor="@color/amp_text_muted" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Win Streak + Ships Sunk row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WIN STREAK"
                            android:textSize="10sp"
                            android:textColor="@color/amp_text_muted"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/stats_win_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amp_lavender" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHIPS SUNK"
                            android:textSize="10sp"
                            android:textColor="@color/amp_text_muted"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/stats_ships_sunk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amp_coral" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Reset Stats Button -->
                <Button
                    android:id="@+id/reset_stats_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:text="Reset Stats"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/amp_coral"
                    android:backgroundTint="@color/amp_surface_2"
                    android:paddingHorizontal="20dp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/amp_coral"
                    app:strokeWidth="1dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Back to Menu -->
        <Button
            android:id="@+id/back_to_menu_button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="← Main Menu"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="@color/amp_text_muted"
            android:backgroundTint="@color/amp_surface_2"
            android:paddingHorizontal="24dp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/amp_border"
            app:strokeWidth="1dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>

</ScrollView>
